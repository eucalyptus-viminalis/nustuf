{
  "name": "nustuf",
  "version": "0.10.0",
  "description": "Agent-native content marketplace \u2014 discover, buy, and publish with Locus payments",
  "type": "module",
  "main": "src/index.js",
  "files": [
    "src/",
    "scripts/",
    "skills/",
    "integrations/",
    "contracts/src/",
    "public/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "nustuf": "scripts/cli.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "cli": "node scripts/cli.js",
    "test": "node --test \"test/*.test.js\"",
    "test:contracts": "cd contracts && forge test",
    "check": "node scripts/check_version_sync.js && node scripts/check_no_local_paths.js && bash scripts/check_skill_security.sh && bash scripts/check_download_code_terminology.sh"
  },
  "keywords": [
    "x402",
    "locus",
    "agents",
    "micropayments",
    "content-marketplace",
    "synthesis-hackathon"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eucalyptus-viminalis/nustuf.git"
  },
  "homepage": "https://github.com/eucalyptus-viminalis/nustuf#readme",
  "bugs": {
    "url": "https://github.com/eucalyptus-viminalis/nustuf/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.45.0",
    "@resvg/resvg-js": "^2.6.2",
    "@x402/core": "^2.3.0",
    "@x402/evm": "^2.3.0",
    "@x402/express": "^2.3.0",
    "dotenv": "^17.2.4",
    "enquirer": "^2.4.1",
    "express": "^5.2.1",
    "viem": "^2.45.2"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "bufferutil",
      "utf-8-validate"
    ]
  }
}
